{
  "name": "serverless-ecommerce-backend",
  "version": "1.0.0",
  "description": "Production-grade backend microservices using AWS Lambda",
  "private": true,
  "workspaces": [
    "auth-service",
    "product-service",
    "cart-service",
    "order-service",
    "inventory-service",
    "payment-service",
    "notification-service",
    "upload-service"
  ],
  "scripts": {
    "install-all": "npm install && for dir in auth-service product-service cart-service order-service inventory-service payment-service notification-service upload-service; do (cd $dir && npm install); done",
    "dev": "serverless offline start",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "lint": "eslint . --ext .js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "serverless": "^3.38.0",
    "serverless-offline": "^13.0.0",
    "serverless-dynamodb-local": "^0.2.40",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "aws-sdk-client-mock": "^3.0.0"
  }
}
